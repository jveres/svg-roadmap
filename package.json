{
	"name": "svg-roadmap",
	"version": "0.1.0",
	"description": "Dependency-light Markdown to SVG roadmap generator",
	"license": "MIT",
	"author": "János Veres",
	"keywords": [
		"markdown",
		"roadmap",
		"svg",
		"typescript",
		"visualization"
	],
	"homepage": "https://github.com/jveres/svg-roadmap#readme",
	"bugs": {
		"url": "https://github.com/jveres/svg-roadmap/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jveres/svg-roadmap.git"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.js",
			"node": "./dist/node.js",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./emoji-github": {
			"types": "./dist/emoji-github.d.ts",
			"import": "./dist/emoji-github.js"
		},
		"./interactive": {
			"types": "./dist/interactive.d.ts",
			"import": "./dist/interactive.js"
		},
		"./viewer": {
			"types": "./dist/viewer.d.ts",
			"import": "./dist/viewer.js"
		},
		"./preview": {
			"types": "./dist/preview.d.ts",
			"import": "./dist/preview.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"LICENSES",
		"README.md"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"build:demo": "vite build --config vite.demo.config.ts",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev": "vite --config vite.demo.config.ts",
		"format": "biome format --write .",
		"generate:emoji": "node scripts/generate-emoji.mjs",
		"generate:readme-sample": "node scripts/generate-readme-sample.mjs",
		"pack:artifact": "node scripts/pack-artifact.mjs",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"verify": "pnpm run check && pnpm run typecheck && pnpm test && pnpm run build && pnpm run build:demo"
	},
	"dependencies": {
		"comrak-wasm": "file:../comrak-wasm"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"fast-check": "^4.9.0",
		"happy-dom": "^20.11.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
